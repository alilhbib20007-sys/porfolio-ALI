{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/index.php?page=accueil" },
    { "src": "^/modules/?$", "dest": "/api/index.php?page=modules" },
    { "src": "^/modules/([a-z0-9-]+)/?$", "dest": "/api/index.php?page=detail&slug=$1" },
    { "src": "^/(td|mini-projets|controles)/?$", "dest": "/api/index.php?page=redirect" },
    { "src": "^/(td|mini-projets|controles)/([a-z0-9-]+)/?$", "dest": "/api/index.php?page=redirect&slug=$2" }
  ]
}
